From 5331c00f37f7d2cbaa2646ebc3734a7959494b18 Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Fri, 10 Jul 2026 09:27:36 +0200
Subject: [PATCH] ubusd_event: document reserved event namespace forgery check

Replace the magic prefix length with a named constant and record why
the strncmp() stays in bounds, so the client-facing event forgery guard
is not mistaken for an out-of-bounds read on untrusted input.

Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
 ubusd_event.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/ubusd_event.c b/ubusd_event.c
index 34e9907..8b65d14 100644
--- a/ubusd_event.c
+++ b/ubusd_event.c
@@ -14,6 +14,10 @@
 #include <arpa/inet.h>
 #include "ubusd.h"
 
+/* Namespace reserved for events generated by ubusd itself (see
+ * ubusd_send_obj_event() and the ubus.acl.sequence event in ubusd_acl.c). */
+#define UBUS_EVENT_RESERVED_PREFIX	"ubus."
+
 static struct avl_tree patterns;
 static struct ubus_object *event_obj;
 static uint16_t event_seq = 0;
@@ -231,7 +235,13 @@ static int ubusd_forward_event(struct ubus_client *cl, struct blob_attr *msg)
 	id = blobmsg_data(attr[EVMSG_ID]);
 	data = attr[EVMSG_DATA];
 
-	if (!strncmp(id, "ubus.", 5))
+	/*
+	 * Reject client attempts to forge events in the reserved namespace.
+	 * blobmsg_parse() above validates EVMSG_ID as a NUL-terminated string,
+	 * so this prefix comparison stays in bounds even for a shorter id.
+	 */
+	if (!strncmp(id, UBUS_EVENT_RESERVED_PREFIX,
+		     sizeof(UBUS_EVENT_RESERVED_PREFIX) - 1))
 		return UBUS_STATUS_PERMISSION_DENIED;
 
 	return ubusd_send_event(cl, id, ubusd_create_event_from_msg, data);
